{
	"compilerOptions": {
		"outDir": "./dist",
		"rootDir": "./src",
		"target": "ES2022",
		"module": "CommonJS",
		"strict": true,
		"esModuleInterop": true,
		"sourceMap": true,
		"lib": ["ES2022", "DOM"],
		"moduleResolution": "node"
	},
	"include": ["src/**/*.ts"],
	"exclude": ["node_modules"],
	"dialectOptions": {
		"ssl": {
			"required": true
		}
	}
}
